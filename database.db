create table public.kabirdatabase_account (
  user_iid bigint generated by default as identity not null,
  name text not null,
  userid text not null,
  password text not null,
  created_at timestamp with time zone null default now(),
  post_limit integer null default 5,
  whats_app_number numeric null,
  profile_photo text null,
  constraint kabirdatabase_account_pkey primary key (user_iid),
  constraint kabirdatabase_account_userid_key unique (userid)
) TABLESPACE pg_default;

create table public.kabirdatabase_postcard (
  postcard_iid bigint generated by default as identity not null,
  image_url text not null,
  title text null,
  thumbnail_url text null,
  created_at timestamp with time zone null default now(),
  constraint kabirdatabase_postcard_pkey primary key (postcard_iid)
) TABLESPACE pg_default;

create table public.kabirdatabase_post (
  post_iid bigint generated by default as identity not null,
  user_iid bigint null,
  postcard_iid bigint null,
  title text null,
  description text null,
  image_url text null,
  is_approved boolean null default false,
  like_count numeric null default 0,
  user_comment jsonb null default '[]'::jsonb,
  created_at timestamp with time zone null default now(),
  constraint kabirdatabase_post_pkey primary key (post_iid),
  constraint kabirdatabase_post_user_iid_fkey foreign key (user_iid) references kabirdatabase_account(user_iid) on delete cascade,
  constraint kabirdatabase_post_postcard_iid_fkey foreign key (postcard_iid) references kabirdatabase_postcard(postcard_iid) on delete set null
) TABLESPACE pg_default;

-- Table to manage the landing / portfolio index page content dynamically via JSONB
create table public.kabirdatabase_home (
  id bigint generated by default as identity not null,
  site_metadata jsonb null default '{}'::jsonb,
  hero jsonb null default '{}'::jsonb,
  marquee jsonb null default '[]'::jsonb,
  about jsonb null default '{}'::jsonb,
  books jsonb null default '[]'::jsonb,
  audio jsonb null default '{}'::jsonb,
  film jsonb null default '{}'::jsonb,
  press jsonb null default '[]'::jsonb,
  connect jsonb null default '{}'::jsonb,
  footer jsonb null default '{}'::jsonb,
  created_at timestamp with time zone null default now(),
  updated_at timestamp with time zone null default now(),
  constraint kabirdatabase_home_pkey primary key (id)
) TABLESPACE pg_default;

-- Row Level Security (RLS) policies for kabirdatabase_home
alter table public.kabirdatabase_home enable row level security;

create policy "Allow public read access to kabirdatabase_home"
  on public.kabirdatabase_home for select using (true);

create policy "Allow public/anon insert to kabirdatabase_home"
  on public.kabirdatabase_home for insert with check (true);

create policy "Allow public/anon update to kabirdatabase_home"
  on public.kabirdatabase_home for update using (true);


