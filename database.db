supabase 

create table public.kabirdatabase (
  created_at timestamp with time zone null,
  title text null,
  description text null,
  section text null,
  image_url text null,
  thumbnail_url text null,
  backup_thumb_url text null,
  image_iid bigint generated by default as identity not null,
  constraint kabirdatabase_pkey primary key (image_iid)
) TABLESPACE pg_default;